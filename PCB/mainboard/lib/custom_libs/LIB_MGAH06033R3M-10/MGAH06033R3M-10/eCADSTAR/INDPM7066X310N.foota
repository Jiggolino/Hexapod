                (geometry
                  (line
                    (vertex
                      (pt -350000 -330000
                        (width 10000)
                      )
                      (pt -350000 330000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
